# Razorpay Test Mode API Keys
# Get yours at: https://dashboard.razorpay.com → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Webhook Secret (optional — for verifying Razorpay webhook signatures)
RAZORPAY_WEBHOOK_SECRET=

# Service Ports
DASHBOARD_PORT=5001
WEBHOOK_PORT=5000

# LLM Configuration (OmniRoute local API)
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=oc/nemotron-3-ultra-free
