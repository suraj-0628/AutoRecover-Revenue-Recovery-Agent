# ─────────────────────────────────────────────────────────────────────────
# AutoRecover — configuration.  Copy this file to `.env` and fill it in:
#     cp .env.example .env
# `.env` is gitignored and never committed.
#
# You need the REQUIRED block to see the agent work. Everything marked
# OPTIONAL is off by default — the app boots and demos without it.
# ─────────────────────────────────────────────────────────────────────────

# ============================ REQUIRED ============================

# 1) Razorpay — TEST MODE keys (free): dashboard.razorpay.com → Account &
#    Settings → API Keys. Used to create real (test) payment links + orders.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 2) LLM — the agent's brain. ANY OpenAI-compatible endpoint works; set the
#    URL, a model, and the key for that provider. A capable REASONING model is
#    recommended — the agent makes real decisions (which rail, whether to
#    discount, when to stop). The example below is OpenAI; swap for your
#    provider (Gemini, Groq, Together, a local router, etc.).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-key-here
#    Optional fallbacks tried in order if the primary is rate-limited/unavailable
#    (comma-separated, same provider). Leave blank to just use LLM_MODEL.
LLM_FALLBACK_MODELS=gpt-4o-mini
#    Per-call time budget across all models (seconds) and a simple rate cap.
LLM_TIMEOUT=90
LLM_CALLS_PER_MINUTE=20

# ============================ OPTIONAL ============================
# The app runs without any of the below. Each feature simply stays off.

# Razorpay webhook signature verification (leave blank to skip verification)
RAZORPAY_WEBHOOK_SECRET=

# Service ports (defaults are fine; change only on a conflict)
DASHBOARD_PORT=5001
WEBHOOK_PORT=5000
# FRONTEND_PORT defaults to 5002

# Email (Brevo). Without these, emails are written to data/outbox/ as .eml
# files instead of being sent — the recovery flow still works end to end.
# SMTP_FROM must be a VERIFIED sender in Brevo. BREVO_API_KEY (xkeysib-…, NOT
# the SMTP password) enables the live daily-quota meter.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BREVO_API_KEY=

# SuperU AI voice calls (100 free: workspace.superu.ai). OFF by default and
# only ever placed as the last, most-gated rung. Flip on in the Guardrail view.
SUPERU_API_KEY=
SUPERU_ASSISTANT_ID=
SUPERU_FROM_PHONE=

# Razorpay test accounts have a 30-payment-link LIFETIME cap. If you reset the
# data/ folder, set how many links this account has already spent so the gauge
# stays honest (0 for a fresh account).
RAZORPAY_LINKS_ALREADY_SPENT=0
